NODE_ENV=development
PORT=3007
DATABASE_URL=postgresql://YOUR_OS_USER@127.0.0.1:5432/dynamic_ui
DATABASE_SSL=disable
FRONTEND_ORIGIN=http://localhost:5173
JWT_SECRET=replace-with-random-32-plus-character-secret
CONNECTOR_ENCRYPTION_KEY=replace-with-base64-encoding-of-exactly-32-random-bytes
AI_PROVIDER_URL=https://provider.example
AI_PROVIDER_API_KEY=
AI_PROVIDER_MODEL=
AI_INPUT_COST_PER_MILLION=0
AI_OUTPUT_COST_PER_MILLION=0
SOURCE_MAX_AGE_SECONDS=86400
JOB_RATE_LIMIT=30
BOOTSTRAP_TENANT_SLUG=
BOOTSTRAP_TENANT_NAME=
BOOTSTRAP_EMAIL=
BOOTSTRAP_NAME=
BOOTSTRAP_PASSWORD=
BOOTSTRAP_ROLE=tenant_admin
